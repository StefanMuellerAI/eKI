# Only the SYNTHETIC test fixtures are versioned (generated by
# tests/generate_pdf_fixtures.py / tests/build_large_fixture.py). Real screenplays
# never go into the repository: keep them in tests/fixtures/pdf/private/ (or
# EKI_PRIVATE_FIXTURES_DIR) for the local tests/run_pdf_*.py runners.
tests/fixtures/pdf/private/
!tests/fixtures/pdf/blank_middle_page.pdf
!tests/fixtures/pdf/german_screenplay.pdf
!tests/fixtures/pdf/german_screenplay_report.pdf
!tests/fixtures/pdf/large_120_pages.pdf
!tests/fixtures/pdf/large_synthetic_300pp.pdf
!tests/fixtures/pdf/multi_scene.pdf
!tests/fixtures/pdf/no_structure.pdf
!tests/fixtures/pdf/no_structure_multi_page.pdf
!tests/fixtures/pdf/password_protected.pdf
!tests/fixtures/pdf/realworld_headings.pdf
!tests/fixtures/pdf/scanned_screenplay.pdf
!tests/fixtures/pdf/simple_screenplay.pdf
!tests/fixtures/pdf/suffix_headings.pdf

