# Multi-stage Dockerfile for Temporal Worker

# Stage 1: Builder
FROM python:3.11-slim as builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (core/version.py is read by setuptools for the dynamic version).
# requirements.lock pins every transitive dependency so image builds are
# reproducible (unpinned builds once pulled SQLAlchemy 2.1 without greenlet).
COPY pyproject.toml requirements.lock ./
COPY core/version.py ./core/version.py

# Install dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -c requirements.lock -e .

# Stage 2: Runtime
FROM python:3.11-slim

WORKDIR /app

# Install runtime dependencies (tesseract = OCR fallback for scanned PDFs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    tesseract-ocr \
    tesseract-ocr-deu \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY api ./api
COPY core ./core
COPY services ./services
COPY workflows ./workflows
COPY worker ./worker
COPY db ./db
COPY llm ./llm
COPY parsers ./parsers
COPY config ./config
COPY tests/fixtures ./tests/fixtures
COPY alembic.ini ./

# Ensure /app is in Python path for module resolution
ENV PYTHONPATH=/app
# Tesseract (OCR fallback) uses OpenMP across all cores; under concurrent load
# (parallel scenes, Ollama on the same host) the threads contend and a single
# page blew through OCR_PAGE_TIMEOUT_SECONDS (>60 s instead of ~1 s), so
# scanned pages were silently skipped. One thread per tesseract process.
ENV OMP_THREAD_LIMIT=1

# Create non-root user
RUN useradd -m -u 1000 eki && chown -R eki:eki /app
USER eki

# Run worker
CMD ["python", "worker/main.py"]
