{
  "uid": "eki-delivery",
  "title": "eKI Delivery (Push/Pull, Retries, DLQ)",
  "tags": [
    "eki",
    "delivery"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Push success ratio (30m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum(rate(eki_delivery_attempts_total{mode=\"push\",outcome=\"success\"}[30m])) / clamp_min(sum(rate(eki_delivery_attempts_total{mode=\"push\"}[30m])), 1e-9)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pull reports ready (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum(increase(eki_delivery_attempts_total{mode=\"pull\",outcome=\"pull_ready\"}[24h]))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "One-shot retrievals (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (outcome) (increase(eki_report_retrievals_total[24h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dead letters (unacked)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "eki_dead_letters_unacknowledged",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Push attempts by outcome (rate/h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (outcome) (rate(eki_delivery_attempts_total{mode=\"push\"}[1h])) * 3600",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Push attempt latency p50 / p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(eki_delivery_duration_seconds_bucket{mode=\"push\"}[1h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(eki_delivery_duration_seconds_bucket{mode=\"push\"}[1h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Delivery failures by reason (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (reason) (increase(eki_delivery_failures_total[24h]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Webhook outcomes (24h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (outcome) (increase(eki_webhook_sent_total[24h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Buffer deletes by trigger (Delete-on-Delivery evidence)",
      "description": "Every successful push/pull must be followed by a buffer delete (Pflichtenheft Abnahmetests 2/3).",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (source) (rate(eki_buffer_deletes_total[1h])) * 3600",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
