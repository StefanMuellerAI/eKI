              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dead letters (unacked)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "eki_dead_letters_unacknowledged",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Version",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "eki_build_info{role=\"api\"}",
          "legendFormat": "{{version}} / {{llm_provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Job duration p50 / p95 vs SLO (s)",
      "description": "Pflichtenheft §5: <=50 scenes 600s, 120 pages 3600s, 300-350 pages 7200s.",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(eki_job_duration_seconds_bucket[6h])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(eki_job_duration_seconds_bucket[6h])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 3600
              },
              {
                "color": "red",
                "value": 7200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Jobs by terminal status (rate/h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (status) (rate(eki_jobs_total[1h])) * 3600",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "HTTP request rate by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (route) (rate(eki_http_requests_total[5m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "HTTP p95 latency by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(eki_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "HTTP 4xx / 5xx share",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum(rate(eki_http_requests_total{status=~\"4..\"}[5m])) / clamp_min(sum(rate(eki_http_requests_total[5m])), 1e-9)",
          "legendFormat": "4xx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum(rate(eki_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(eki_http_requests_total[5m])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Scenes processed / findings (rate per h)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "eki-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (stage) (rate(eki_scenes_processed_total[1h])) * 3600",
          "legendFormat": "scenes {{stage}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "eki-prometheus"
          },
          "expr": "sum by (severity) (rate(eki_findings_total[1h])) * 3600",
          "legendFormat": "findings {{severity}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
