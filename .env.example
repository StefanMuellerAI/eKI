# eKI API Environment Configuration
#
# Docker Compose: copy this file to .env.local (env_file of the api, worker,
# postgres and temporal services) and replace every CHANGE_ME value:
#     cp .env.example .env.local
# Outside Docker (pytest, scripts on the host) Settings reads `.env` in the
# current directory instead -- plus real environment variables, which win.
# Changes in .env.local only take effect after the containers are recreated:
#     docker compose up -d --force-recreate api worker
# (`docker compose restart` does NOT re-read env_file.)
# NEVER commit .env.local / .env to version control!
# Full reference of every setting: docs/CONFIGURATION.md

# Environment: development | stage | production ("prod" also counts as production).
# ENV=production enables the startup validator (strong secrets, DEBUG=false,
# no mistral_cloud) -- the CHANGE_ME placeholders below are rejected there.
ENV=development
# DEBUG=true serves /docs, /redoc, /openapi.json and echoes SQL; development only.
DEBUG=true

# Database (read by the postgres container ONLY when its volume is initialised
# for the first time; later changes need ALTER USER, see docs/OPERATIONS_GUIDE.md).
# The password must be identical in POSTGRES_PASSWORD, POSTGRES_PWD and DATABASE_URL.
# Generate one with: python3 scripts/generate_secrets.py (writes secrets/*.txt)
POSTGRES_DB=eki_db
POSTGRES_USER=eki_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
# Temporal auto-setup expects POSTGRES_PWD (same password, same user)
POSTGRES_PWD=CHANGE_ME_STRONG_PASSWORD_HERE

# Database Connection (api, worker, alembic, scripts/create_api_key.py)
DATABASE_URL=postgresql+asyncpg://eki_user:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/eki_db
# Connection pool of the API process (code defaults)
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
# Optional *_FILE variant (Docker-secret pattern): the file must exist INSIDE the
# container -- no compose file mounts secrets/ by default, add the mount yourself
# (secrets/README.md). A set *_FILE wins over the plain value; an unreadable or
# empty file aborts startup. scripts/create_api_key.py only reads DATABASE_URL.
# DATABASE_URL_FILE=/run/secrets/database_url

# Redis (SecureBuffer, rate limiting). The compose stack pins redis:7.2-alpine (last
# BSD-licensed line; upstream support ends with Redis 7.4's, see docs/OPERATIONS_GUIDE.md).
# Updating an installation that ran redis:7-alpine (= 7.4): drain, then empty the
# redis_data volume -- 7.2 cannot load 7.4 data files (upgrade checklist in the same guide).
REDIS_URL=redis://redis:6379/0
# Connection cap of the per-request Redis pool in the API (code default 50)
REDIS_MAX_CONNECTIONS=50
# Lifetime of encrypted script/report content in Redis (Pflichtenheft <= 6 h).
# Also the pull window: a report not fetched within it is deleted + dead-lettered.
BUFFER_TTL_SECONDS=21600

# Temporal
TEMPORAL_HOST=temporal:7233
# API and worker both connect to this namespace. temporalio/auto-setup only
# creates "default"; keep it unless you create the namespace yourself.
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=security-check
# M10: muss groesser sein als max. Verarbeitungszeit (2h) + 6h Retry/Pull-TTL,
# sonst beendet Temporal den Workflow vor Cleanup/Webhook. Default 10h.
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=36000
# Task-queue priority levels (request field `priority` 1..10 is mapped onto 1..N).
# Must equal matching.priorityLevels in docker/temporal/dynamicconfig/eki.yaml.
TEMPORAL_PRIORITY_LEVELS=10

# API Security
# Master secret: Fernet key derivation for the Redis SecureBuffer and the KB
# originals, and (since 1.0.1) the key of the Temporal payload encryption.
# API and worker MUST use the same value. Changing it makes buffered jobs, KB
# originals and open workflows undecryptable -- drain first (rotation runbook:
# docs/OPERATIONS_GUIDE.md). >= 32 chars, generate it.
API_SECRET_KEY=CHANGE_ME_256_BIT_SECRET_KEY_HERE
# API_SECRET_KEY_FILE=/run/secrets/api_secret_key
# Only behind your own reverse proxy: honour X-Forwarded-For from these exact
# peer IPs (comma-separated, no CIDR) for the per-IP rate limit.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# Metrics (/metrics on the API, exporter on PROMETHEUS_PORT in the worker)
METRICS_ENABLED=true

# LLM Provider (local_mistral, ollama, mistral_cloud)
# Achtung: Provider-Namen mit UNTERSTRICH, nicht Bindestrich.
# Ein abweichender String (z.B. "mistral-cloud") wird vom
# Validator in api/config.py beim App-Start abgewiesen.
# Ohne diesen Eintrag gilt der Code-Default mistral_cloud -- daher explizit setzen.
# docker-compose.prod.yml setzt LLM_PROVIDER fuer api/worker per Compose-Substitution
# (Default local_mistral) und ueberschreibt damit diesen Wert, siehe docs/CONFIGURATION.md.
LLM_PROVIDER=local_mistral
# EXTERNAL Ollama instance (the compose stack contains no Ollama since 1.0.1):
# REPLACE the placeholder with your Ollama host -- used for inference and KB
# embeddings by API and worker. Nothing checks it at startup (/ready does not),
# jobs fail at the first LLM call if it is wrong. With the optional dev overlay
# docker-compose.ollama.yml the overlay sets http://ollama:11434 itself.
OLLAMA_BASE_URL=http://ollama-host.invalid:11434
# Model for LLM_PROVIDER=ollama only (local_mistral uses LOCAL_MISTRAL_MODEL).
# Examples: mistral-small3.2, gemma4:31b, qwen3.6:35b. Code default: mistral
OLLAMA_MODEL=mistral-small3.2
# Optional Ollama tuning (defaults shown). Also used by local_mistral.
OLLAMA_TIMEOUT=300
# Disable thinking mode for thinking-capable models (gemma4, qwen3.x)
# so structured output stays clean and fast. Ignored by mistral.
OLLAMA_THINK=false
# Context window: must cover system + taxonomy + schema + scene text.
# Lower (e.g. 16384) saves VRAM on small dev models.
OLLAMA_NUM_CTX=32768
# Embedding model for the M06 Knowledge Base (local_mistral and ollama).
# MUST produce 1024-dim vectors. Pull it once on the Ollama host:
#   ollama pull mxbai-embed-large
# (with the dev overlay: docker compose -f docker-compose.yml -f docker-compose.ollama.yml
#  exec ollama ollama pull mxbai-embed-large)
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# Pre-truncate embed() input to fit the embedder context window.
# mxbai-embed-large hard 512-token limit ~= 1100 chars of German/Markdown
# (verified); 1000 is the safe ceiling.
# Alternative: OLLAMA_EMBEDDING_MODEL=bge-m3 together with
# OLLAMA_EMBEDDING_MAX_CHARS=30000. Switching the embedding model later
# requires wiping and re-seeding the KB (vectors are not comparable).
OLLAMA_EMBEDDING_MAX_CHARS=1000

# M11 -- Lokaler Produktiv-Adapter (LLM_PROVIDER=local_mistral)
# Modell-Tag in Ollama; Default gemaess Pflichtenheft 4.3. Einmalig auf dem Ollama-Host:
#   ollama pull mistral-small3.2
# (mit dem Dev-Overlay: docker compose -f docker-compose.yml -f docker-compose.ollama.yml
#  exec ollama ollama pull mistral-small3.2)
LOCAL_MISTRAL_MODEL=mistral-small3.2
# Optional eigener Ollama-Endpoint fuer den Adapter (Inferenz und Embeddings;
# Default: OLLAMA_BASE_URL)
# LOCAL_MISTRAL_BASE_URL=http://gpu-box:11434
# In ENV=production wird mistral_cloud abgelehnt, solange dieser Schalter false ist.
LLM_ALLOW_EXTERNAL_PROVIDERS=false

# Mistral Cloud (if using mistral_cloud provider; Stage only, no KB embeddings)
# MISTRAL_API_KEY=your-mistral-api-key-here
# MISTRAL_API_KEY_FILE=/run/secrets/mistral_api_key
# Optional: model und timeout. Defaults aus api/config.py (Code-Default).
# Beispiele fuer model: mistral-large-latest, mistral-small-latest,
# mistral-medium-latest. Aktueller Default-Wert: mistral-large-latest.
# MISTRAL_MODEL=mistral-large-latest
# MISTRAL_TIMEOUT=120

# Knowledge Base (M06)
# Master switch for KB retrieval in the risk analysis pipeline.
# Default OFF -> risk flow stays byte-identical to M05.
KB_RETRIEVAL_ENABLED=false
# Tenant UUID used for all KB documents (single-tenant default).
KB_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
# Top-k chunks injected per scene when retrieval is ON.
KB_TOP_K=3
# Max chars per chunk in the prompt to bound context length.
KB_MAX_CHUNK_CHARS_IN_PROMPT=600

# eProjekt Integration (push delivery of risk assessments)
# Default push target: EPRO_BASE_URL/eki/scl/set-risk-assessment/{project_id};
# a request's callback_url replaces it for that job (since 1.0.1).
# docker-compose.yml maps staging.epro.filmakademie.de to 193.196.129.23 (extra_hosts):
# for local/UAT runs point EPRO_BASE_URL/EPRO_WEBHOOK_URL at the ePro mock
# (scripts/uat/mock_epro_server.py), otherwise push jobs reach the real Stage.
EPRO_BASE_URL=https://staging.epro.filmakademie.de/api
# Auth is IP-based (no token needed). Set only if ePro adds token auth later:
# EPRO_AUTH_TOKEN=
# EPRO_AUTH_TOKEN_FILE=/run/secrets/epro_auth_token
EPRO_TIMEOUT=30
# Hosts a request's callback_url may point to (comma-separated or JSON list; exact
# host match, no wildcards). The ePro token is sent along, hence the allow-list;
# checked by the API (422) and again by the worker before every push -- both
# read this file. Empty = every callback_url is rejected.
CALLBACK_URL_ALLOWED_HOSTS=epro.filmakademie.de,staging.epro.filmakademie.de

# M08 -- security.delivery.failed Webhook (opt-in).
# Leer = Webhook deaktiviert (Default). Beim Setzen postet die eKI nach
# erschoepftem 6h-Push-Retry oder einem 4xx-Hard-Fail einen
# Metadaten-Webhook gemaess Pflichtenheft Anhang 1. Payload enthaelt
# job_id, report_id, reason, attempts -- KEINEN Reportinhalt.
# EPRO_WEBHOOK_URL=https://staging.epro.filmakademie.de/api/eki/scl/delivery-failed
# EPRO_WEBHOOK_URL_FILE=/run/secrets/epro_webhook_url

# Practically without effect: the request field `delivery` decides (pull | push;
# omitted or blank = push with a callback_url, otherwise pull). Code fallback only.
DELIVERY_MODE=pull

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=https://epro.filmakademie.de,https://staging.epro.filmakademie.de

# Logging (json | console). docker-compose.prod.yml forces LOG_FORMAT=json.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting (per source IP per minute + per presented API key per hour)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Reserved / unused: API_HOST, API_PORT, API_WORKERS, API_RELOAD and
# API_TOKEN_EXPIRE_MINUTES exist in api/config.py but are read nowhere.
# Bind address, port and process model come from the Dockerfile CMD and
# docker-compose.prod.yml (gunicorn). Setting them has no effect.

# =====================================================================
# M07 -- Großdokument-Optimierung (Pflichtenheft §5/§7.6)
#
# Defaults so wählen, dass das Verhalten ohne Konfig-Wechsel bytewise
# identisch zum M06-Stand bleibt. Parallel-Pfad greift NUR, wenn
# LLM_PARALLEL_ENABLED=true UND mindestens eine *_CONCURRENCY > 1 ist.
# Die API friert LLM_PARALLEL_ENABLED, *_CONCURRENCY, LLM_ACTIVITY_TIMEOUT_SECONDS
# und BUFFER_TTL_SECONDS beim Jobstart ein: Änderungen gelten für neue Jobs.
#
# Ausfuehrlich: docs/LASTSTEUERUNG.md
#
# WICHTIG: Ollama läuft i.d.R. auf einer geteilten GPU-Instanz, andere
# Anwendungen können denselben Endpoint nutzen. Erhöhe
# OLLAMA_MAX_CONCURRENT_REQUESTS nur, wenn Du sicher weißt, dass die
# GPU genug VRAM für N gleichzeitige Inferenzen hat. Im Zweifel auf 1
# lassen.
# =====================================================================

# Master-Flag: Default OFF = identisches Verhalten zu M06.
LLM_PARALLEL_ENABLED=false

# Prozessweiter Hard-Cap für gleichzeitige Ollama-Requests.
# Wirkt über alle Workflows und Activities hinweg.
# Empfohlene Stufen:
#   1  Default, identisch zu M06 (serialisiert)
#   2  Konservativ, ~1.6-1.8x Speedup bei dediziertem System
#   3  Sportlich, nur bei reichlich VRAM
#   >=4  Nicht empfohlen, Risiko von VRAM-Engpässen
OLLAMA_MAX_CONCURRENT_REQUESTS=1

# Optionaler Mindestabstand zwischen zwei Ollama-Calls (Millisekunden).
# 0 = aus. Für sehr knapp dimensionierte Shared-GPU-Systeme sinnvoll.
OLLAMA_MIN_INTERVAL_MS=0

# Per-Workflow-Cap: maximal parallel ausgeführte LLM-Activities pro
# Workflow. Defaults = 1 (sequenziell). Werte > 1 nur in Kombination
# mit LLM_PARALLEL_ENABLED=true wirksam.
PDF_STRUCTURE_CONCURRENCY=1
RISK_ANALYSIS_CONCURRENCY=1

# start_to_close_timeout für LLM-Activities (Sekunden).
# Vor M07 hardcoded 300s; 600s federt Backoff bei voller Ollama-Queue ab.
LLM_ACTIVITY_TIMEOUT_SECONDS=600

# OCR-Fallback fuer bildbasierte PDF-Seiten (Pflichtenheft 4.1). Tesseract ist im
# Docker-Image enthalten; ohne Binary werden Scan-Seiten mit Warnung uebersprungen.
OCR_ENABLED=true
OCR_LANGUAGES=deu+eng
OCR_MAX_PAGES=50
OCR_DPI=300
OCR_PAGE_TIMEOUT_SECONDS=60

# PDF-Parser-Limits (vor M07 Modul-Konstanten). MAX_UPLOAD_SIZE_BYTES gilt fuer
# Multipart-Uploads; JSON-Uploads sind fest begrenzt (Base64-Text max. 10 MiB,
# also Dateien bis ca. 7,5 MiB).
MAX_PDF_PAGES=500
MAX_PDF_SIZE_BYTES=10485760
MAX_UPLOAD_SIZE_BYTES=10485760

# Temporal-Worker-Caps (vor M07 hardcoded):
WORKER_MAX_CONCURRENT_WORKFLOW_TASKS=10
WORKER_MAX_CONCURRENT_ACTIVITIES=20

# Dokument-Limit: so viele Jobs werden gleichzeitig verarbeitet; alle weiteren
# warten als "pending" in einer Warteschlange (Prioritaet, dann Eingang), ohne
# Worker-Platz und ohne laufendes Activity-Timeout. 1 passt zu einer GPU mit
# OLLAMA_NUM_PARALLEL=1 auf dem Ollama-Server. 0 = kein Limit (Verhalten bis
# 1.0.1: alle Jobs laufen verzahnt und teilen sich die KI). Die Grenze liest der
# Worker beim Start; nach "up -d --force-recreate api worker" gilt sie auch fuer
# schon wartende Jobs. Ob sich ein Job anstellt, friert die API beim Jobstart ein.
# Alle Last-, Parallelitaets- und Zeitlimit-Einstellungen im Detail (inkl. der
# Variablen des Ollama-Servers): docs/LASTSTEUERUNG.md
MAX_CONCURRENT_DOCUMENTS=1
# Hoechstwartezeit auf einen Verarbeitungsplatz, danach "failed" (gilt fuer neue
# Jobs). Muss kuerzer sein als BUFFER_TTL_SECONDS und zusammen mit ihm unter
# TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT bleiben (Start-Validator).
DOCUMENT_QUEUE_TIMEOUT_SECONDS=7200

# Generate secure passwords with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# =====================================================================
# M09 -- Observability & SLOs
# =====================================================================

# OpenTelemetry tracing (opt-in). Requires an OTLP/HTTP collector, e.g. the
# Jaeger service from docker-compose.observability.yml. That overlay sets
# OTEL_ENABLED=${OTEL_ENABLED:-true} and the endpoint for api/worker itself,
# overriding the values below (compose substitution, see docs/CONFIGURATION.md).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=eki-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Worker-side Prometheus exporter port (internal network only, never published).
PROMETHEUS_PORT=9090

# Maintenance schedules (Temporal). Cron = exactly 5 fields in UTC, validated at
# startup (API and worker refuse to start on an invalid value); keep the quotes.
# The worker creates/updates both schedules on every start; *_ENABLED=false
# pauses an existing schedule.
# Knowledge-Base TTL cleanup (daily 03:00 UTC by default).
KB_CLEANUP_ENABLED=true
KB_CLEANUP_CRON="0 3 * * *"
# Metadata retention (since 1.0.1): deletes job/report metadata, dead letters
# (acknowledged or not), unusable API keys and audit logs older than N days (>= 1).
# Rules: docs/DATENSCHUTZ.md section 4.
METADATA_RETENTION_DAYS=90
METADATA_CLEANUP_ENABLED=true
METADATA_CLEANUP_CRON="30 3 * * *"

# Grafana admin credentials for docker-compose.observability.yml.
# NOT read from .env.local: Compose substitutes ${GRAFANA_ADMIN_*} from the shell
# or a project-level .env file (export them before `docker compose ... up`).
# Unset, the Grafana admin password is literally CHANGE_ME.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME
