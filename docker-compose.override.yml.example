# Docker Compose Override Example
#
# Copy this file to docker-compose.override.yml to customize your setup
# cp docker-compose.override.yml.example docker-compose.override.yml
#
# Inference runs on an EXTERNAL Ollama instance; its URL comes from .env.local
# (LOCAL_MISTRAL_BASE_URL for LLM_PROVIDER=local_mistral, OLLAMA_BASE_URL for
# LLM_PROVIDER=ollama and the KB embeddings). For a local Ollama container
# (development / offline) use the separate overlay instead of this file:
#   docker compose -f docker-compose.yml -f docker-compose.ollama.yml up -d

services:
  # API with local inference (same provider/model as production: local_mistral).
  # These values override .env.local -- keep them in sync or remove them.
  api:
    environment:
      - LLM_PROVIDER=local_mistral
      - LOCAL_MISTRAL_MODEL=mistral-small3.2

  # Worker: must use the same provider/model as the API
  worker:
    environment:
      - LLM_PROVIDER=local_mistral
      - LOCAL_MISTRAL_MODEL=mistral-small3.2
    # ---------------------------------------------------------------
    # M07 – Ressourcenlimits (Pflichtenheft §7 Abnahmetest 6:
    # "Ressourcenlimits werden eingehalten")
    #
    # Die folgenden Werte sind KONSERVATIVE Startwerte. Sobald die
    # finale Zielhardware steht (siehe Pflichtenheft §5: Server mit
    # GPU ≥ 24 GB VRAM), bitte hier an die tatsächliche Maschine
    # anpassen. Aktivieren durch Auskommentieren.
    # ---------------------------------------------------------------
    # deploy:
    #   resources:
    #     limits:
    #       memory: 4g
    #       cpus: "2"
    #     reservations:
    #       memory: 1g

  # ----------------------------------------------------------------
  # M07 – API-Ressourcen (analog Worker, niedrigerer Bedarf)
  # ----------------------------------------------------------------
  # api:
  #   deploy:
  #     resources:
  #       limits:
  #         memory: 2g
  #         cpus: "1"
  #       reservations:
  #         memory: 512m

  # ----------------------------------------------------------------
  # M07 – Ollama: läuft extern (geteilte GPU-Instanz, andere Anwendungen
  # können denselben Endpoint nutzen). Den prozessweiten Concurrency-Cap
  # setzen wir software-seitig via OLLAMA_MAX_CONCURRENT_REQUESTS in
  # .env.local; Container-Limits für einen lokalen Ollama-Container
  # gehören in docker-compose.ollama.yml.
  # ----------------------------------------------------------------
